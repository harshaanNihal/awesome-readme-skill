{
  "baseUrl": "http://127.0.0.1:4599/",
  "outDir": "docs/images",
  "viewport": { "width": 1440, "height": 900, "scale": 2 },
  "server": { "command": "node", "args": ["serve.mjs", "--port", "4599"], "cwd": "." },
  "shots": [
    {
      "name": "hero.png",
      "path": "/?theme=light",
      "steps": [{ "waitFor": "#note-list .note" }]
    },
    {
      "name": "add-note.png",
      "path": "/?theme=light",
      "element": "body",
      "steps": [
        { "type": "#note-title", "text": "Order seed packets" },
        { "type": "#note-body", "text": "Basil and chives are low. Add a second mint pot to the order." },
        { "eval": "document.querySelector('#note-tag').value = 'home'" },
        { "click": "#add-note" },
        { "waitFor": "[data-id='9']" }
      ]
    },
    {
      "name": "search.png",
      "path": "/?theme=light",
      "element": "body",
      "steps": [
        { "type": "#search", "text": "date" },
        { "waitForText": "^Showing 3 of 8", "selector": "#count" }
      ]
    },
    {
      "name": "tag-filter.png",
      "path": "/?theme=light",
      "element": "body",
      "steps": [
        { "click": "[data-tag='ideas']" },
        { "waitForText": "^Showing 2 of 8", "selector": "#count" }
      ]
    },
    {
      "name": "dark-theme.png",
      "path": "/?theme=dark",
      "steps": [
        { "click": "[data-id='2'] [data-action='pin']" },
        { "waitFor": "[data-id='2'].pinned" }
      ]
    }
  ],
  "gif": {
    "name": "demo.gif",
    "path": "/?theme=light",
    "viewport": { "width": 1000, "height": 720, "scale": 1 },
    "maxKB": 4096,
    "steps": [
      { "wait": 1000 },
      { "type": "#note-title", "text": "Order seed packets", "delay": 60 },
      { "type": "#note-body", "text": "Basil and chives are low.", "delay": 40 },
      { "eval": "document.querySelector('#note-tag').value = 'home'" },
      { "wait": 400 },
      { "click": "#add-note" },
      { "wait": 700 },
      { "click": "[data-id='9'] [data-action='pin']" },
      { "wait": 900 },
      { "click": "[data-tag='home']" },
      { "wait": 2500 }
    ]
  }
}
